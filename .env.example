# Canonical origin. On Vercel this is derived from VERCEL_PROJECT_PRODUCTION_URL
# automatically — set it only for a custom domain, or for local metadata checks.
NEXT_PUBLIC_SITE_URL=

# Where early-access sign-ups are POSTed as {email, source}. Defaults to the
# Supabase edge function in supabase/functions/signup, so this only needs
# setting to point a fork somewhere else.
NEXT_PUBLIC_SIGNUP_ENDPOINT=
