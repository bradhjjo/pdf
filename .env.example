# Canonical origin. On Vercel this is derived from VERCEL_PROJECT_PRODUCTION_URL
# automatically — set it only for a custom domain, or for local metadata checks.
NEXT_PUBLIC_SITE_URL=

# Where early-access sign-ups are POSTed as {email, source, at}.
# Unset: the form still works and keeps addresses in the visitor's browser only.
NEXT_PUBLIC_SIGNUP_ENDPOINT=
